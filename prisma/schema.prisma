// ── PPT progress / proof comment attachments ────────────────────────────────

enum PptCommentAttachmentKind {
  PROGRESS
  PROOF
}

enum PptCommentAttachmentStatus {
  /// Bytes are on Linear, but no comment references them yet.
  UPLOADED
  /// Referenced by a posted Linear comment. Terminal.
  POSTED
}

/// An image, PDF or video attached to a PPT progress or proof comment.
///
/// Both upload paths (the multipart proxy and the Vercel Blob relay) finish
/// synchronously, so a row only ever exists for bytes that reached Linear —
/// there is no pending state to reconcile.
///
/// The reason this is persisted rather than just embedded in the comment
/// markdown: the client must never hand a URL to a comment-posting path. It
/// sends these ids, the server resolves the URLs from its own table, and a
/// tampered or replayed id therefore resolves to nothing instead of putting an
/// attacker-chosen URL into a third-party system. It doubles as the
/// rate-limit ledger and lets admins see proof attachments even when
/// PptPayoutState.proofCommentBody truncates past them.
model PptCommentAttachment {
  id            String      @id @default(cuid())
  linearIssueId String
  uploadedById  String
  uploadedBy    UserProfile @relation("PptCommentAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  kind   PptCommentAttachmentKind
  status PptCommentAttachmentStatus @default(UPLOADED)

  filename       String
  mimeType       String
  byteSize       Int
  width          Int?
  height         Int?
  linearAssetUrl String
  /// How the bytes travelled: "proxy" | "relay" | "dev". Diagnostic only.
  transport      String
  sortOrder      Int    @default(0)

  linearCommentId String?
  postedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([linearIssueId, uploadedById, status])
  /// Rolling-hour rate-limit ledger scan.
  @@index([uploadedById, createdAt])
  /// Retention sweep for uploads that were never posted.
  @@index([status, createdAt])
}

// ── KYC Verification tables ─────────────────────────────────────────────────

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model KycVerification {
  id                 String      @id @default(cuid())
  userId             String
  user               UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             KycStatus   @default(PENDING)
  legalName          String
  documentType       String? // mykad | passport | driving_licence
  idDocumentBlobUrl  String?
  selfieBlobUrl      String?
  rejectionReason    String?
  reviewerId         String?
  submittedAt        DateTime    @default(now())
  reviewedAt         DateTime?
  documentsDeletedAt DateTime?
  expiresAt          DateTime

  auditLogs KycAuditLog[]

  @@index([userId])
  @@index([status])
}

/**
 * Reads of the most sensitive PII. Every other audit model in this schema
 * records mutations; this one records access — who looked at whose government
 * ID or bank details, and when. Written by logPiiAccess() in
 * src/lib/pii-audit.ts.
 */
model PiiAccessLog {
  id         String   @id @default(cuid())
  /**
   * UserProfile id of the reader, and of the subject whose data was read
   * (null for aggregate, page-level rows). Plain strings with no relation,
   * like WelcomePackOrderEvent.actorId — deleting a user must not cascade away
   * the record of what they read.
   */
  actorId    String
  subjectId  String?
  /**
   * KYC_ID_DOCUMENT | KYC_SELFIE | BANK_DETAILS | WELCOME_PACK_ADDRESS
   */
  resource   String
  /**
   * verificationId | transactionId | orderId
   */
  resourceId String?
  /**
   * Route path or action name.
   */
  context    String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([resource, createdAt])
}

model KycAuditLog {
  id             String          @id @default(cuid())
  verificationId String
  verification   KycVerification @relation(fields: [verificationId], references: [id])
  actorId        String
  action         String // SUBMITTED | APPROVED | REJECTED | EXPIRED | DOCUMENTS_DELETED
  details        String?
  createdAt      DateTime        @default(now())

  @@index([verificationId])
}

// ── Welcome Pack tables ─────────────────────────────────────────────────────

enum WelcomePackOrderStatus {
  PENDING
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
}

enum ShippingRegion {
  DOMESTIC
  INTERNATIONAL
}

model WelcomePack {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  currentWave Int     @default(1)
  wave2Open   Boolean @default(false)

  // Ordering window — gates order *creation* only; the pack page stays
  // visible. Evaluated at read/submit time (no cron).
  orderingEnabled Boolean   @default(true)
  ordersOpenAt    DateTime?
  ordersCloseAt   DateTime?

  // Default lead times used to seed per-order logistics estimates on
  // approval. Admins can override the order-level dates later.
  defaultDomesticFulfillmentDays      Int @default(14)
  defaultInternationalFulfillmentDays Int @default(21)
  defaultDomesticDeliveryDays         Int @default(3)
  defaultInternationalDeliveryDays    Int @default(14)

  // Default parcel dimensions/weight + declared-value currency used to fill the
  // EasyParcel export when an order has no per-order override. Nullable so
  // existing packs stay "not export-ready" until an admin sets real values
  // rather than shipping guessed parcel data. Currency must be one of the
  // template-supported codes (see EASYPARCEL_CURRENCIES).
  defaultParcelWeightKg Float?
  defaultParcelLengthCm Float?
  defaultParcelWidthCm  Float?
  defaultParcelHeightCm Float?
  defaultParcelCurrency String?

  // ID card overlay configuration
  idCardTemplateBlobUrl String?
  idCardWidth           Int?
  idCardHeight          Int?
  idCardNameX           Int?
  idCardNameY           Int?
  idCardFontSize        Int?
  idCardFontColor       String?
  idCardFontFamily      String?
  // Text-box constraints + behaviour for long names.
  // Width/height in template px (null = unbounded).
  // Align: "left" | "center" | "right" (default "left").
  // WrapMode: "nowrap" (single line, may overflow) | "truncate" (single line + ellipsis)
  //         | "wrap" (multi-line within box) | "shrink" (single line, font auto-shrinks).
  idCardNameMaxWidth    Int?
  idCardNameMaxHeight   Int?
  idCardNameAlign       String?
  idCardNameWrapMode    String?

  items  WelcomePackItem[]
  orders WelcomePackOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WelcomePackItem {
  id     String      @id @default(cuid())
  packId String
  pack   WelcomePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  imageBlobUrl String?

  requiresSize     Boolean  @default(false)
  sizeChartBlobUrl String?
  sizeOptions      String[]

  // Customs declaration data — intrinsic to the item, used per line on the
  // EasyParcel export (Item Name / Price Per Item / HS Code columns).
  // Nullable so existing items are "not export-ready" until an admin fills
  // them; declared value is in the pack's default parcel currency.
  customsDescription String?
  declaredUnitValue  Float?
  hsCode             String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  selections WelcomePackOrderItemSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packId])
}

model WelcomePackOrder {
  id           String      @id @default(cuid())
  userId       String
  user         UserProfile @relation(fields: [userId], references: [id])
  // Equals userId while the order is active (PENDING/APPROVED/SHIPPED/
  // DELIVERED), NULL once CANCELLED or REJECTED. Postgres allows many NULLs
  // in a unique index, so a user can have many terminal orders but at most
  // one active order. Every status transition MUST keep this in sync.
  activeUserId String?     @unique
  packId       String
  pack         WelcomePack @relation(fields: [packId], references: [id])

  status WelcomePackOrderStatus @default(PENDING)
  wave   Int

  idCardName String

  region          ShippingRegion
  // Shipping PII. Nullable because the data-retention cron clears it once the
  // order is settled — see WELCOME_PACK_ADDRESS_FIELDS in
  // src/lib/welcome-pack-events.ts and addressPurgedAt below. Nullable rather
  // than a "[purged]" tombstone so `pnpm typecheck` enumerates every reader
  // and a purged order can never silently reach a courier workbook.
  recipientName   String?
  phone           String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  stateProvince   String?
  postalCode      String?
  country         String
  /**
   * Set when the retention sweep cleared the shipping fields above.
   */
  addressPurgedAt DateTime?

  trackingNumber         String?
  trackingUrl            String?
  carrierName            String?
  estimatedFulfillmentAt DateTime?
  estimatedDeliveryAt    DateTime?
  logisticsNote          String?
  delayedAt              DateTime?
  delayReason            String?
  notes                  String?
  rejectionReason        String?

  // Per-order EasyParcel logistics. Parcel dims/weight override the pack
  // defaults when the actual parcel differs; null = fall back to pack default.
  // addressIsResidential maps to the template's residential Yes/No column;
  // null exports as residential. taxId is optional for EasyParcel bulk export.
  parcelWeightKg       Float?
  parcelLengthCm       Float?
  parcelWidthCm        Float?
  parcelHeightCm       Float?
  addressIsResidential Boolean?
  taxId                String?

  // EasyParcel export audit — drives the "previously exported" badge and the
  // re-export confirmation guard.
  easyParcelExportedAt  DateTime?
  easyParcelExportCount Int       @default(0)

  // Audit trail of the eligibility check that admitted this order — for
  // wave 1 this is the qualifying Linear issues; for wave 2 it just records
  // that the wave-2 flag was open at submission time.
  eligibilitySnapshot Json?

  selections WelcomePackOrderItemSelection[]
  events     WelcomePackOrderEvent[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvedAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([packId])
  // Drives the data-retention sweep's scan for settled orders.
  @@index([status, deliveredAt])
}

model WelcomePackOrderItemSelection {
  id           String           @id @default(cuid())
  orderId      String
  order        WelcomePackOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  item         WelcomePackItem  @relation(fields: [itemId], references: [id])
  selectedSize String?

  @@unique([orderId, itemId])
}

model WelcomePackOrderEvent {
  id      String           @id @default(cuid())
  orderId String
  order   WelcomePackOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // UserProfile id of whoever acted; null for SYSTEM. Plain string like
  // IncentiveEvent.userId — no relation, resolved to a name at render time.
  actorId   String?
  actorRole String // "ADMIN" | "USER" | "SYSTEM"
  // See WelcomePackOrderEventType in src/lib/welcome-pack-events.ts for the
  // full set of values.
  type      String
  message   String?
  metadata  Json? // { before, after } diffs for edits; reason for reject/cancel

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([type, createdAt])
}
