generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── better-auth tables ──────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  profile  UserProfile?
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Application tables ──────────────────────────────────────────────────────

model UserProfile {
  id              String  @id // Matches better-auth User.id
  user            User    @relation(fields: [id], references: [id], onDelete: Cascade)
  discordId       String? @unique
  robloxId        String? @unique
  linearId        String? @unique
  linearEmail     String? @unique
  // Display identity. Every human-facing surface (UI, email, notification,
  // Linear comment) must resolve names through resolveDisplayName() in
  // src/lib/display-name.ts — never read legalName for display.
  preferredName   String?
  // Compliance identity ONLY: KYC, document signing, payout verification and
  // courier labels. Collected under an explicit promise that it is never shown
  // to other developers. Guarded by scripts/dev/check-pii.ts.
  legalName       String?
  shippingAddress String? // For merch

  // Roles and Permissions
  role               Role                 @default(DEVELOPER)
  developerRank      DeveloperRank        @default(PROBATIONARY_DEVELOPER)
  specialties        DeveloperSpecialty[] @default([])
  probationStartedAt DateTime             @default(now())
  initialReviewAt    DateTime?
  finalReviewAt      DateTime?

  // Payment Preferences
  paymentMethod     PaymentMethod @default(PAYPAL)
  paypalEmail       String?
  duitNowId         String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  robuxUsername     String?

  /// Which kind of DuitNow proxy `duitNowId` is. Required to pay: the admin's
  /// bank asks for the type before the value, and the value cannot reveal it —
  /// a TnG eWallet account number, an NRIC, and Maybank/Affin/CCB/KFH/Standard
  /// Chartered/Merchantrade/Boost/Setel/Instapay account numbers are all 12
  /// digits with no distinguishing prefix. Null on rows predating this column
  /// whose value was not unambiguously a mobile number; those are re-collected
  /// on next edit rather than guessed at.
  duitNowIdType      DuitNowIdType?
  /// How far the ID has been checked. UNCONFIRMED is every legacy row.
  /// CONFIRMED is the developer's own assertion that they registered it.
  /// RESOLVED/UNREACHABLE are written only from a real bank lookup by an admin.
  /// Display only — this must never gate a payout, or the backfill would make
  /// every existing proxy payout unpayable on the day it ships.
  duitNowIdStatus    DuitNowIdStatus @default(UNCONFIRMED)
  duitNowIdCheckedAt DateTime?
  /// Why a lookup failed, as a closed set rather than free text: this row is
  /// read by a bare findUnique and handed whole to a client component, so
  /// anything stored here is visible to the developer it describes.
  duitNowIdIssue     DuitNowIdIssue?

  // Auto-payout opt-in for ewallet methods (requires KYC)
  autoPayoutEnabled Boolean @default(false)

  // Getting-started checklist: completion is DERIVED from real data (claims,
  // proofs, payouts); only the dismissal is persisted.
  gettingStartedDismissedAt DateTime?

  // Relationships
  transactions            Transaction[]
  pptPayoutStates         PptPayoutState[]            @relation("PptPayoutStateUser")
  pptAssignmentWatches    PptAssignmentWatch[]        @relation("PptAssignmentWatchUser")
  notificationsReceived   Notification[]              @relation("NotificationRecipient")
  notificationsActed      Notification[]              @relation("NotificationActor")
  notificationPreferences NotificationPreference[]
  bonusCandidates         BonusCandidate[]            @relation("BonusCandidateUser")
  bonusReviews            BonusCandidate[]            @relation("BonusCandidateReviewer")
  issueCompletions        IssueCompletion[]           @relation("IssueCompletionUser")
  incentiveAwards         IncentiveAward[]            @relation("IncentiveAwardUser")
  incentiveAwardsDisputed IncentiveAward[]            @relation("IncentiveAwardDisputer")
  incentiveAwardsApproved IncentiveAward[]            @relation("IncentiveAwardApprover")
  incentiveActivityDays   UserActivityDay[]
  incentiveClawbackDebts  IncentiveClawbackDebt[]     @relation("IncentiveClawbackDebtUser")
  invites                 Invite[]
  signedDocuments         SignedDocument[]
  pptRequestsMade         PptRequest[]                @relation("PptRequestRequester")
  pptRequestsReviewed     PptRequest[]                @relation("PptRequestReviewer")
  pptRequestAttachments   PptRequestAttachment[]      @relation("PptRequestAttachmentUploader")
  pptCommentAttachments   PptCommentAttachment[]      @relation("PptCommentAttachmentUploader")
  kycVerifications        KycVerification[]
  welcomePackOrders       WelcomePackOrder[]
  projectMemberships      ProjectMembership[]         @relation("ProjectMember")
  projectAssignmentsMade  ProjectMembership[]         @relation("ProjectAssignmentActor")
  accessSyncLogs          AccessSyncLog[]             @relation("AccessSyncUser")
  accessSyncActions       AccessSyncLog[]             @relation("AccessSyncActor")
  achievements            DeveloperAchievement[]      @relation("DeveloperAchievementUser")
  payoutCampaignsCreated  PayoutCampaign[]            @relation("PayoutCampaignCreator")
  campaignApplications    PayoutCampaignApplication[] @relation("PayoutCampaignApplicationUser")
  taskSuggestions         TaskSuggestion[]            @relation("TaskSuggestionUser")
  taskSuggestionsMade     TaskSuggestion[]            @relation("TaskSuggestionActor")
  assistantConversations  AssistantConversation[]
  assistantActions        AssistantAction[]
}

// Persisted, peer-visible recognition. Keys live in src/lib/achievements.ts
// and reward completion/delivery — never raw claim volume. The unique
// constraint makes awarding idempotent across webhook + cron paths.
model DeveloperAchievement {
  id       String      @id @default(cuid())
  userId   String
  user     UserProfile @relation("DeveloperAchievementUser", fields: [userId], references: [id], onDelete: Cascade)
  key      String
  earnedAt DateTime    @default(now())
  // Gates one-time celebrations (e.g. first-payout confetti fires once).
  seenAt   DateTime?
  meta     Json?

  @@unique([userId, key])
  @@index([userId, earnedAt])
}

model Invite {
  id        String      @id @default(cuid())
  token     String      @unique
  creatorId String
  creator   UserProfile @relation(fields: [creatorId], references: [id])
  used      Boolean     @default(false)
  usedById  String?
  createdAt DateTime    @default(now())
}

/// The activation funnel's missing moments — the ones that leave no other
/// trace. Most of the funnel is already recorded (PptAssignmentWatch for
/// claims, PptPayoutState.proofProvidedAt for proof, PptPayoutEvent for
/// rejected proof, Transaction for payouts, TaskSuggestion.outcome for
/// pushes), so this table deliberately does NOT duplicate them — it records
/// first-time crossings so "how far did each person get" is one query.
///
/// userId is a plain column with no foreign key: deleting a user must not
/// cascade away the record that they were here.
model ActivationEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  /// One row per crossing. Webhooks, crons and retries all re-fire the same
  /// moment, so the writer swallows the duplicate rather than counting it.
  @@unique([userId, kind, entityId])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// Every model call DevHub makes, so spend is a number rather than a guess.
/// Doubles as the rate-limit ledger — checkLlmRateLimits counts rows in a
/// rolling window, the same shape EmailDelivery uses for email throttling.
///
/// userId is a plain column with no foreign key: deleting a user must not
/// erase the record of what was spent on their behalf.
model LlmCall {
  id                String   @id @default(cuid())
  /// Which feature asked. Rate limits are scoped per surface.
  surface           String
  userId            String?
  model             String
  provider          String   @default("anthropic")
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cachedInputTokens Int      @default(0)
  reasoningTokens   Int      @default(0)
  latencyMs         Int?
  failureKind       String?
  conversationId    String?
  runId             String?
  fallbackFromId    String?
  /// False when the call failed or was refused — still billed, still counted.
  ok                Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([surface, createdAt])
  @@index([provider, createdAt])
  @@index([conversationId, createdAt])
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}

enum AssistantMessageStatus {
  PENDING
  COMPLETE
  INTERRUPTED
  FAILED
}

enum AssistantActionStatus {
  PENDING
  EXECUTING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// A private, user-owned assistant thread. Provider-side conversation objects
/// are deliberately not used; DevHub is the canonical store and deletion
/// therefore has one unambiguous meaning.
model AssistantConversation {
  id         String      @id @default(cuid())
  userId     String
  user       UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  entryPoint String?
  archivedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  messages AssistantMessage[]
  actions  AssistantAction[]

  @@index([userId, archivedAt, updatedAt])
}

model AssistantMessage {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   AssistantConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AssistantMessageRole
  content        String                 @db.Text
  status         AssistantMessageStatus @default(COMPLETE)
  provider       String?
  model          String?
  references     Json?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  actions AssistantAction[]

  @@index([conversationId, createdAt])
}

/// A model may propose a write, but only this persisted, user-confirmed record
/// may execute one. Confirmation revalidates current state and transitions the
/// row with a compare-and-set update, making retries idempotent.
model AssistantAction {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        AssistantMessage?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  userId         String
  user           UserProfile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           String
  payload        Json
  preview        Json
  status         AssistantActionStatus @default(PENDING)
  expiresAt      DateTime
  executedAt     DateTime?
  result         Json?
  error          String?
  errorCode      String?
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([conversationId, createdAt])
  @@index([userId, status, expiresAt])
}

model EmailDelivery {
  id             String              @id @default(cuid())
  dedupeKey      String              @unique
  idempotencyKey String?
  fingerprint    String
  recipient      String
  subject        String
  category       String
  status         EmailDeliveryStatus @default(PENDING)
  providerId     String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([recipient, createdAt])
  @@index([idempotencyKey])
  @@index([fingerprint, createdAt])
  @@index([category, createdAt])
  @@index([status, createdAt])
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id      String       @id @default(cuid())
  userId  String
  user    UserProfile  @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId String?
  actor   UserProfile? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  domain     String
  type       String
  title      String
  message    String
  href       String?
  entityType String?
  entityId   String?
  payload    Json?
  dedupeKey  String? @unique

  deliveries NotificationDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([actorId])
  @@index([domain, type])
  @@index([entityType, entityId])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel          String
  status           String    @default("PENDING")
  readAt           DateTime?
  seenAt           DateTime?
  sentAt           DateTime?
  skippedReason    String?
  failedReason     String?
  providerMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([notificationId, channel])
  @@index([channel, status])
  @@index([channel, readAt])
  @@index([channel, seenAt])
  @@index([notificationId])
}

model NotificationPreference {
  id     String      @id @default(cuid())
  userId String
  user   UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain  String
  type    String
  channel String
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, domain, type, channel])
  @@index([userId])
  @@index([domain, type])
}

enum Role {
  ADMIN
  DEVELOPER
}

enum DeveloperRank {
  PROBATIONARY_DEVELOPER
  JUNIOR_DEVELOPER
  DEVELOPER
  SENIOR_DEVELOPER
  DEVELOPER_COUNCIL
  HEAD_DEVELOPER
}

enum DeveloperSpecialty {
  SCRIPTING
  BUILDING
  MESHING
  VEHICLES
}

enum ProjectAccessLevel {
  CONTRIBUTOR
  DEVELOPER
  PUBLISHER
}

enum AccessSyncPlatform {
  ROBLOX_OPEN_CLOUD
  ROBLOX_LEGACY
  DISCORD
  LINEAR
}

enum AccessSyncStatus {
  SUCCESS
  FAILED
  SKIPPED
}

model AccessIntegrationConfig {
  id                                    String   @id @default("default")
  robloxDevelopmentGroupId              String?
  robloxPublisherGroupId                String?
  robloxDevelopmentLegacyFallbackRoleId Int?
  robloxPublisherLegacyFallbackRoleId   Int?
  robloxOpenCloudEnabled                Boolean  @default(true)
  robloxLegacyEnabled                   Boolean  @default(false)
  discordGuildId                        String?
  discordEnabled                        Boolean  @default(true)
  linearEnabled                         Boolean  @default(true)
  createdAt                             DateTime @default(now())
  updatedAt                             DateTime @updatedAt
}

model RankRoleMapping {
  id                 String        @id @default(cuid())
  rank               DeveloperRank @unique
  robloxRoleId       String?
  robloxLegacyRoleId Int?
  discordRoleId      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model SpecialtyRoleMapping {
  id            String             @id @default(cuid())
  specialty     DeveloperSpecialty @unique
  discordRoleId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model DevProject {
  id                            String              @id @default(cuid())
  name                          String              @unique
  slug                          String              @unique
  description                   String?
  isActive                      Boolean             @default(true)
  robloxContributorRoleId       String?
  robloxDeveloperRoleId         String?
  robloxPublisherRoleId         String?
  robloxContributorLegacyRoleId Int?
  robloxDeveloperLegacyRoleId   Int?
  robloxPublisherLegacyRoleId   Int?
  discordContributorRoleId      String?
  discordDeveloperRoleId        String?
  discordPublisherRoleId        String?
  linearTeamId                  String?
  linearProjectId               String?
  memberships                   ProjectMembership[]
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
}

model ProjectMembership {
  id                      String             @id @default(cuid())
  userId                  String
  user                    UserProfile        @relation("ProjectMember", fields: [userId], references: [id], onDelete: Cascade)
  projectId               String
  project                 DevProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accessLevel             ProjectAccessLevel
  allowJuniorRobloxAccess Boolean            @default(false)
  assignedById            String?
  assignedBy              UserProfile?       @relation("ProjectAssignmentActor", fields: [assignedById], references: [id])
  notes                   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([userId, projectId])
  @@index([projectId])
}

model AccessSyncLog {
  id        String             @id @default(cuid())
  userId    String
  user      UserProfile        @relation("AccessSyncUser", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     UserProfile?       @relation("AccessSyncActor", fields: [actorId], references: [id])
  platform  AccessSyncPlatform
  status    AccessSyncStatus
  dryRun    Boolean            @default(false)
  action    String
  details   Json?
  error     String?
  createdAt DateTime           @default(now())

  @@index([userId])
  @@index([platform, status])
}

model AccessManagedRole {
  id        String             @id @default(cuid())
  platform  AccessSyncPlatform
  scope     String
  roleId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([platform, scope, roleId])
  @@index([platform, scope])
}

enum PaymentMethod {
  PAYPAL
  DUITNOW
  ROBUX
  BANK_TRANSFER
}

/// DuitNow proxy types, mirroring PayNet's proxy enum
/// (MBNO / NRIC / BREG / PSPT / ARMN). Rules live in src/lib/duitnow-id.ts.
enum DuitNowIdType {
  MOBILE
  NRIC
  BUSINESS_REG
  PASSPORT
  ARMY_POLICE
}

enum DuitNowIdStatus {
  UNCONFIRMED
  CONFIRMED
  RESOLVED
  UNREACHABLE
}

enum DuitNowIdIssue {
  NOT_FOUND
  NAME_MISMATCH
  WRONG_TYPE
  REGISTERED_ELSEWHERE
}

model Transaction {
  id                    String                      @id @default(cuid())
  userId                String
  user                  UserProfile                 @relation(fields: [userId], references: [id])
  linearIssueId         String?                     @unique // To prevent double crediting
  linearIssueIdentifier String? // e.g. "DEV-123"
  linearIssueTitle      String?
  linearIssueUrl        String?
  amount                Float
  /// Pre-multiplier amount. Equals `amount` outside a campaign. The weekly
  /// credit limit aggregates this column, never `amount`, so a promo cannot
  /// push developers past their auto-approval limit.
  baseAmount            Float?
  campaignId            String?
  campaignMultiplier    Float?
  currency              String                      @default("USD") // Or "R$"
  source                TransactionSource           @default(PPT)
  bonusPeriod           String? // YYYY-MM for grouped monthly bonus payouts
  status                TxStatus                    @default(PENDING) // PENDING, PAID, CANCELLED, REJECTED
  autoApproved          Boolean                     @default(false) // Pre-vetted under weekly credit limit
  createdAt             DateTime                    @default(now())
  paidAt                DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?
  pdfBlobUrl            String?
  payout                Payout?
  bonusCandidates       BonusCandidate[]
  incentiveAwards       IncentiveAward[]
  pptPayoutState        PptPayoutState?
  campaignApplications  PayoutCampaignApplication[]
}

enum TransactionSource {
  PPT
  BONUS
  MANUAL
  INCENTIVE
}

model Payout {
  id               String         @id @default(cuid())
  transactionId    String         @unique
  transaction      Transaction    @relation(fields: [transactionId], references: [id])
  provider         PayoutProvider
  providerPayoutId String?        @unique // External ID from provider (e.g. Billplz payment order ID)
  status           PayoutStatus   @default(PENDING)
  providerData     Json? // Provider-specific request/response data
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?
}

enum PayoutProvider {
  BILLPLZ
  XENDIT
  ROBLOX
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TxStatus {
  PENDING
  PAID
  CANCELLED
  REJECTED
  ON_HOLD
}

// ── PPT payout eligibility tables ──────────────────────────────────────────

model PptPayoutState {
  id                    String    @id @default(cuid())
  linearIssueId         String    @unique
  linearIssueIdentifier String?
  linearIssueTitle      String?
  linearIssueUrl        String?
  latestLinearStateType String?
  latestLinearStateName String?
  latestLinearUpdatedAt DateTime?
  hasPptLabel           Boolean   @default(false)
  estimate              Float?

  userId           String?
  user             UserProfile? @relation("PptPayoutStateUser", fields: [userId], references: [id], onDelete: SetNull)
  assigneeLinearId String?
  assigneeEmail    String?
  assigneeName     String?

  status               PptPayoutStatus  @default(BLOCKED)
  reason               PptPayoutReason?
  completionEpisode    Int              @default(0)
  completedAt          DateTime?
  canceledAt           DateTime?
  archivedAt           DateTime?
  trashed              Boolean          @default(false)
  lastReopenedAt       DateTime?
  latestAssignmentAt   DateTime?
  lastAssigneeChangeAt DateTime?
  lastEstimateChangeAt DateTime?

  proofCommentId       String?
  proofCommentUrl      String?
  proofCommentBody     String?
  proofAuthorLinearId  String?
  proofProvidedAt      DateTime?
  proofOverride        Boolean   @default(false)
  proofOverrideById    String?
  proofOverrideAt      DateTime?
  proofOverrideNote    String?
  proofOverrideEpisode Int?

  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  /// Campaign locked in at first payout eligibility. Recompute paths (estimate
  /// changed, ON_HOLD release) reuse this instead of re-resolving against the
  /// clock, so an expiring campaign never silently reprices a live payout.
  campaignId         String?
  campaignMultiplier Float?

  warningCount            Int              @default(0)
  lastDeveloperNotifiedAt DateTime?
  lastAdminNotifiedAt     DateTime?
  lastLinearCommentReason PptPayoutReason?
  lastLinearCommentAt     DateTime?

  events PptPayoutEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, reason])
  @@index([userId, status])
  @@index([completedAt])
  @@index([latestLinearUpdatedAt])
}

model PptPayoutEvent {
  id            String             @id @default(cuid())
  stateId       String
  state         PptPayoutState     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  linearIssueId String
  type          PptPayoutEventType
  reason        PptPayoutReason?
  actorLinearId String?
  message       String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  @@index([stateId, createdAt])
  @@index([linearIssueId, createdAt])
  @@index([type, createdAt])
}

enum PptPayoutStatus {
  BLOCKED
  NEEDS_PROOF
  WAITING_STABILITY
  READY_FOR_PAYOUT
  TRANSACTION_PENDING
  ON_HOLD
  PAID
  FLAGGED
}

enum PptPayoutReason {
  MISSING_PPT_LABEL
  PPT_LABEL_REMOVED
  PPT_LABEL_REMOVED_DURING_PAYOUT_PROCESSING
  PAID_ISSUE_LABEL_REMOVED
  NOT_COMPLETED
  ISSUE_CANCELED
  ISSUE_CANCELED_DURING_PAYOUT_PROCESSING
  PAID_ISSUE_CANCELED
  ISSUE_ARCHIVED_OR_TRASHED
  ISSUE_ARCHIVED_DURING_PAYOUT_PROCESSING
  PAID_ISSUE_ARCHIVED
  MISSING_ESTIMATE
  MISSING_ASSIGNEE
  NO_LINKED_USER
  MISSING_PROOF
  /// Proof was posted but failed the ppt-proof.ts check — distinct from
  /// MISSING_PROOF so the developer is told their comment was read and why it
  /// didn't qualify, rather than being told to post proof they already posted.
  PROOF_NOT_QUALIFYING
  PROOF_RESET_BY_QUESTION
  PAID_ISSUE_NEEDS_REVIEW
  WAITING_STABILITY
  DUPLICATE_TRANSACTION
  APPROVED_BONUS_EXISTS
  LINEAR_API_ERROR
  REOPENED_BEFORE_PAYOUT
  REOPENED_DURING_PAYOUT_PROCESSING
  PAID_ISSUE_REOPENED
  ASSIGNEE_CHANGED_AFTER_PAYOUT_CHECK
  ASSIGNEE_CHANGED_DURING_PAYOUT_PROCESSING
  PAID_ISSUE_REASSIGNED
  ESTIMATE_CHANGED_RECALCULATED
  ESTIMATE_CHANGED_DURING_PROCESSING
  PAID_ISSUE_ESTIMATE_CHANGED
  STALE_LINEAR_WEBHOOK
  READY_FOR_PAYOUT
  TRANSACTION_CREATED
  AUTO_PAYOUT_STARTED
}

enum PptPayoutEventType {
