# ─── Dev mode (mock) environment — COMMITTED, FAKE VALUES ONLY ──────────────
# Loaded with override by `pnpm dev:mock` (scripts/dev/dev-mock.ts) and the
# simulate/smoke scripts. Every variable the app reads must have an entry here
# so real values from .env/.env.local can never leak into a mock run.
#
# NEVER copy real secrets into this file. NEVER set DEV_MODE outside it.

DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true
NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local `prisma dev` server (name: devhub-mock). The orchestrator captures the
# actual TCP URL from `prisma dev --detach` output at boot and overrides these;
# this default matches the URL the CLI prints on this machine.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
DIRECT_DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# The embedded server mishandles concurrent extended-protocol sessions —
# serialise the pg pool (src/lib/prisma.ts reads this; unset in production).
PG_POOL_MAX=1

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must match MOCK_BETTER_AUTH_SECRET in src/lib/dev-mode.ts (safety assertion).
BETTER_AUTH_SECRET=devhub-mock-better-auth-secret-do-not-use-in-prod
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── OAuth providers (flows are not used in dev mode; accounts are seeded) ───
LINEAR_CLIENT_ID=mock-linear-client-id
LINEAR_CLIENT_SECRET=mock-linear-client-secret
DISCORD_CLIENT_ID=mock-discord-client-id
DISCORD_CLIENT_SECRET=mock-discord-client-secret
ROBLOX_CLIENT_ID=mock-roblox-client-id
ROBLOX_CLIENT_SECRET=mock-roblox-client-secret

# ─── Linear ──────────────────────────────────────────────────────────────────
LINEAR_SERVICE_API_KEY=mock-linear-service-api-key
LINEAR_API_KEY=mock-linear-api-key
LINEAR_WEBHOOK_SECRET=mock-linear-webhook-secret

# ─── Discord bot / Roblox ────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=mock-discord-bot-token
ROBLOX_GROUP_ID=12345678
ROBLOX_OPEN_CLOUD_API_KEY=mock-roblox-open-cloud-api-key
ROBLOX_OPEN_CLOUD_TOKEN=mock-roblox-open-cloud-token
ROBLOX_LEGACY_COOKIE=mock-roblox-legacy-cookie

# ─── FinSys (Robux payouts) ──────────────────────────────────────────────────
# Non-loopback mock hostname so requests route through the fetch interceptor
# (src/dev/intercept.ts) instead of the localhost passthrough.
FINSYS_API_URL=http://finsys.devhub-mock.local
FINSYS_API_KEY=mock-finsys-api-key

# ─── Payments ────────────────────────────────────────────────────────────────
BILLPLZ_API_SECRET_KEY=mock-billplz-api-secret-key
BILLPLZ_XSIGNATURE_KEY=mock-billplz-xsignature-key
BILLPLZ_PAYMENT_ORDER_COLLECTION_ID=mock-billplz-collection
BILLPLZ_SANDBOX=true
XENDIT_API_KEY=mock-xendit-api-key
XENDIT_CALLBACK_VERIFICATION_TOKEN=mock-xendit-callback-token

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=mock-resend-api-key
EMAIL_FROM=MYSverse DevHub Dev <devhub@localhost>
EMAIL_SENDS_DISABLED=false
EMAIL_DEDUPE_WINDOW_MINUTES=60
EMAIL_MAX_SENDS_PER_HOUR=250
EMAIL_MAX_SENDS_PER_RECIPIENT_PER_HOUR=25
EMAIL_MAX_SENDS_PER_CATEGORY_PER_HOUR=100

# ─── Redis (Upstash REST) ────────────────────────────────────────────────────
# Non-loopback mock hostname → handled by the fetch interceptor.
KV_REST_API_URL=http://upstash.devhub-mock.local
KV_REST_API_TOKEN=mock-kv-rest-api-token

# ─── Blob storage (@vercel/blob) ─────────────────────────────────────────────
# @vercel/blob bundles its own undici fetch, so it bypasses the interceptor;
# VERCEL_BLOB_API_URL points it at the standalone mock server started by
# instrumentation (src/dev/blob-server.ts — Next would 308 the SDK's
# trailing-slash PUTs). Stored bytes are served at /api/dev/blob/<pathname>.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_MOCKMOCKMOCKMOCK_mockmockmockmockmockmock
VERCEL_BLOB_API_URL=http://127.0.0.1:4983

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET=mock-cron-secret

# ─── PPT tuning ──────────────────────────────────────────────────────────────
# No stability wait in dev mode so completed→proof→payout flows run instantly.
PPT_STABILITY_MINUTES=0
