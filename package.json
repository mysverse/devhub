{
  "name": "devhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "tsx scripts/dev/dev-mock.ts",
    "dev:mock:reset": "tsx scripts/dev/dev-mock.ts --reset",
    "dev:mock:seed": "tsx scripts/dev/dev-mock.ts --seed-only",
    "dev:mock:stop": "tsx scripts/dev/dev-mock.ts --stop",
    "build": "prisma generate && next build",
    "build:mock": "dotenv -e .env.mock -- pnpm build",
    "start": "next start",
    "lint": "biome lint --write",
    "check": "biome check --write",
    "typecheck": "prisma generate && tsc --noEmit",
    "smoke": "tsx scripts/dev/smoke.ts",
    "simulate": "tsx scripts/dev/simulate.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@linear/sdk": "^86.0.0",
    "@mantine/core": "^9.3.0",
    "@mantine/dates": "^9.3.0",
    "@mantine/hooks": "^9.3.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-pdf/renderer": "^4.5.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.4.0",
    "better-auth": "^1.6.14",
    "dayjs": "^1.11.21",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "motion": "^12.40.0",
    "motion-plus": "https://api.motion.dev/registry.tgz?package=motion-plus&version=2.10.0&token=65a016326afe0ae8bdb421c58d3ee596c18c692519e30c84914b81f3b136fa7a",
    "next": "16.2.7",
    "pg": "^8.21.0",
    "postcss": "^8.5.15",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "^6.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
