{
  "name": "devhub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "tsx scripts/dev/dev-mock.ts",
    "dev:mock:reset": "tsx scripts/dev/dev-mock.ts --reset",
    "dev:mock:seed": "tsx scripts/dev/dev-mock.ts --seed-only",
    "dev:mock:stop": "tsx scripts/dev/dev-mock.ts --stop",
    "build": "prisma generate && next build",
    "build:mock": "dotenv -e .env.mock -- pnpm build",
    "start": "next start",
    "lint": "biome lint --write",
    "check": "biome check --write && tsx scripts/dev/check-migrations.ts",
    "check-migrations": "tsx scripts/dev/check-migrations.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke": "tsx scripts/dev/smoke.ts",
    "simulate": "tsx scripts/dev/simulate.ts",
    "repair:ppt-payouts": "tsx scripts/dev/repair-ppt-payouts.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@linear/sdk": "^88.0.0",
    "@mantine/core": "^9.4.1",
    "@mantine/dates": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@react-pdf/renderer": "^4.5.1",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.5.0",
    "better-auth": "^1.6.23",
    "dayjs": "^1.11.21",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "motion": "^12.42.2",
    "motion-plus": "https://api.motion.dev/registry.tgz?package=motion-plus&version=2.10.0&token=65a016326afe0ae8bdb421c58d3ee596c18c692519e30c84914b81f3b136fa7a",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "postcss": "^8.5.16",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "^6.6.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^25.9.4",
    "@types/pg": "8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
