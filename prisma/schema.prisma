enum PayoutCampaignScope {
  PPT
  BONUS
  INCENTIVE
}

/// A limited-time payout multiplier ("3x PPT this sprint"). Campaigns never
/// stack — the highest multiplier wins. `enabled` is a master switch that wins
/// over the schedule; within the schedule `startsAt` is inclusive and `endsAt`
/// is exclusive (see getCampaignWindowState in src/lib/payout-campaign.ts).
model PayoutCampaign {
  id         String                @id @default(cuid())
  slug       String                @unique
  name       String
  multiplier Float
  scopes     PayoutCampaignScope[]
  enabled    Boolean               @default(false)
  startsAt   DateTime
  endsAt     DateTime

  // Targeting. Empty arrays mean "no restriction on this dimension".
  includedLabels     String[]        @default([])
  excludedLabels     String[]        @default([])
  ranks              DeveloperRank[] @default([])
  participantUserIds String[]        @default([])

  // Guardrails, per currency. 0 means unlimited.
  upliftPoolMyr           Float   @default(0)
  upliftPoolRobux         Float   @default(0)
  perUserUpliftCapMyr     Float   @default(0)
  perUserUpliftCapRobux   Float   @default(0)
  /// When true (default) the PPT weekly credit limit is evaluated against the
  /// pre-multiplier amount, so a promo never changes who gets auto-approved.
  creditLimitOnBaseAmount Boolean @default(true)

  // Presentation
  headline    String
  body        String?
  accentColor String  @default("violet")

  createdById String?
  createdBy   UserProfile? @relation("PayoutCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  applications PayoutCampaignApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, startsAt, endsAt])
}

/// One row per multiplied amount: the audit trail, the uplift pool ledger, and
/// the idempotency key. Written when the amount is decided, which for bonuses
/// and incentives happens long before a Transaction exists.
model PayoutCampaignApplication {
  id         String              @id @default(cuid())
  campaignId String
  campaign   PayoutCampaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  scope      PayoutCampaignScope
  /// PptPayoutState.id | BonusCandidate.id | IncentiveAward.id
  entityId   String

  userId String
  user   UserProfile @relation("PayoutCampaignApplicationUser", fields: [userId], references: [id], onDelete: Cascade)

  currency     String
  baseAmount   Float
  multiplier   Float
  /// final - base; the amount charged against the campaign uplift pool.
  upliftAmount Float

  reverted   Boolean   @default(false)
  revertedAt DateTime?

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, scope, entityId])
  @@index([campaignId, currency, reverted])
  @@index([userId, campaignId, currency])
  @@index([transactionId])
}

