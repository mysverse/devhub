# ─── Dev Mode ──────────────────────────────────────────────────────────────
# Set to "true" to run without DB, auth, or external services.
# All data will be mocked. Use with `pnpm dev` for UI iteration.
# NEXT_PUBLIC_DEV_MODE=true

# ─── Database ──────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/devhub

# ─── Auth ──────────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# ─── OAuth Providers ───────────────────────────────────────────────────────
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ROBLOX_CLIENT_ID=
# ROBLOX_CLIENT_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=MYSverse DevHub <devhub@mysver.se>
# Default same-recipient/category/subject throttle for email paths without an
# explicit idempotency key. Set to 0 to disable the fallback window.
# EMAIL_DEDUPE_WINDOW_MINUTES=60
# Set any of these to 0 to disable that hourly cap.
# EMAIL_MAX_SENDS_PER_HOUR=250
# EMAIL_MAX_SENDS_PER_RECIPIENT_PER_HOUR=25
# EMAIL_MAX_SENDS_PER_CATEGORY_PER_HOUR=100
# Emergency kill switch: when true, DevHub records no Resend sends.
# EMAIL_SENDS_DISABLED=false
