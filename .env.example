# ─── Dev Mode ──────────────────────────────────────────────────────────────
# To run without a real DB, auth, or external services use `pnpm dev:mock`,
# which loads the committed .env.mock (do NOT set DEV_MODE/NEXT_PUBLIC_DEV_MODE
# here or in .env.local — they are owned exclusively by .env.mock).
# See AGENTS.md "Dev Mode" and .claude/skills/dev-mode/SKILL.md.

# ─── Database ──────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/devhub

# ─── Auth ──────────────────────────────────────────────────────────────────
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000

# ─── OAuth Providers ───────────────────────────────────────────────────────
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# ROBLOX_CLIENT_ID=
# ROBLOX_CLIENT_SECRET=

# ─── Email ─────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=MYSverse DevHub <devhub@mysver.se>
# Default same-recipient/category/subject throttle for email paths without an
# explicit idempotency key. Set to 0 to disable the fallback window.
# EMAIL_DEDUPE_WINDOW_MINUTES=60
# Set any of these to 0 to disable that hourly cap.
# EMAIL_MAX_SENDS_PER_HOUR=250
# EMAIL_MAX_SENDS_PER_RECIPIENT_PER_HOUR=25
# EMAIL_MAX_SENDS_PER_CATEGORY_PER_HOUR=100
# Emergency kill switch: when true, DevHub records no Resend sends.
# EMAIL_SENDS_DISABLED=false

# ─── PPT Tuning ────────────────────────────────────────────────────────────
# PPT_STABILITY_MINUTES=60
# PPT_HOGGING_WARNING_HOURS=48
# PPT_HOGGING_UNASSIGN_HOURS=72
# PPT_HOGGING_SNOOZE_HOURS=72

# ─── LLM adapters + Task Copilot ──────────────────────────────────────────
# Optional. Powers drafting/triage and, when enabled, the private task copilot.
# Leave both provider keys unset and all surfaces retain their manual path.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_API_KEY=
# Which model to draft with. Defaults to claude-sonnet-5 — near-Opus quality on
# this kind of scoping work at a fraction of the cost. claude-haiku-4-5 is
# cheaper again; claude-opus-5 is available if draft quality ever justifies it.
# ANTHROPIC_MODEL=claude-sonnet-5
# Primary/fallback are filtered to providers whose key is present.
# LLM_PROVIDER=openai
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_ASSISTANT_ENABLED=true
# LLM_ASSISTANT_MAX_TURNS_PER_HOUR=20
# Rolling-hour caps over the LlmCall ledger; 0 disables that scope. Reaching a
# cap returns null, so callers fall back to the manual path rather than erroring.
# LLM_MAX_CALLS_PER_HOUR=200
# LLM_MAX_CALLS_PER_USER_PER_HOUR=12
