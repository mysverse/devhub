generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── better-auth tables ──────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  profile       UserProfile?
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Application tables ──────────────────────────────────────────────────────

model UserProfile {
  id               String   @id // Matches better-auth User.id
  user             User     @relation(fields: [id], references: [id], onDelete: Cascade)
  discordId        String?  @unique
  robloxId         String?  @unique
  linearId         String?  @unique
  linearEmail      String?  @unique
  legalName        String?
  shippingAddress  String?  // For merch

  // Roles and Permissions
  role             Role     @default(DEVELOPER)

  // Payment Preferences
  paymentMethod    PaymentMethod @default(PAYPAL)
  paypalEmail      String?
  duitNowId        String?
  bankName         String?
  bankAccountNumber String?
  bankAccountName  String?
  robuxUsername    String?

  // Auto-payout opt-in for ewallet methods (requires KYC)
  autoPayoutEnabled Boolean  @default(false)

  // Relationships
  transactions     Transaction[]
  invites          Invite[]
  signedDocuments  SignedDocument[]
  pptRequestsMade     PptRequest[] @relation("PptRequestRequester")
  pptRequestsReviewed PptRequest[] @relation("PptRequestReviewer")
  kycVerifications KycVerification[]
  welcomePackOrder WelcomePackOrder?
}

model Invite {
  id               String   @id @default(cuid())
  token            String   @unique
  creatorId        String
  creator          UserProfile @relation(fields: [creatorId], references: [id])
  used             Boolean  @default(false)
  usedById         String?
  createdAt        DateTime @default(now())
}

enum Role {
  ADMIN
  DEVELOPER
}

enum PaymentMethod {
  PAYPAL
  DUITNOW
  ROBUX
  BANK_TRANSFER
}

model Transaction {
  id               String   @id @default(cuid())
  userId           String
  user             UserProfile @relation(fields: [userId], references: [id])
  linearIssueId    String?  @unique // To prevent double crediting
  linearIssueIdentifier String? // e.g. "DEV-123"
  linearIssueTitle String?
  linearIssueUrl   String?
  amount           Float
  currency         String   @default("USD") // Or "R$"
  status           TxStatus @default(PENDING) // PENDING, PAID, CANCELLED, REJECTED
  autoApproved     Boolean  @default(false) // Pre-vetted under weekly credit limit
  createdAt        DateTime @default(now())
  paidAt           DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  pdfBlobUrl       String?
  payout           Payout?
}

model Payout {
  id               String         @id @default(cuid())
  transactionId    String         @unique
  transaction      Transaction    @relation(fields: [transactionId], references: [id])
  provider         PayoutProvider
  providerPayoutId String?        @unique // External ID from provider (e.g. Billplz payment order ID)
  status           PayoutStatus   @default(PENDING)
  providerData     Json?          // Provider-specific request/response data
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?
}

enum PayoutProvider {
  BILLPLZ
  XENDIT
  ROBLOX
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TxStatus {
  PENDING
  PAID
  CANCELLED
  REJECTED
}

enum DocumentType {
  COI
  NDA
}

model SignedDocument {
  id              String       @id @default(cuid())
  userId          String
  user            UserProfile  @relation(fields: [userId], references: [id])
  documentType    DocumentType
  templateVersion String
  templateContent String
  legalName       String
  signedAt        DateTime     @default(now())
  ipAddress       String?

  coiEntries      CoiEntry[]

  @@unique([userId, documentType])
}

model CoiEntry {
  id                  String         @id @default(cuid())
  signedDocumentId    String
  signedDocument      SignedDocument  @relation(fields: [signedDocumentId], references: [id], onDelete: Cascade)
  organizationName    String
  natureOfInvolvement String
  description         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

// ── PPT Request tables ──────────────────────────────────────────────────────

enum PptRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model PptRequest {
  id                    String           @id @default(cuid())
  requesterId           String
  requester             UserProfile      @relation("PptRequestRequester", fields: [requesterId], references: [id])
  reviewerId            String?
  reviewer              UserProfile?     @relation("PptRequestReviewer", fields: [reviewerId], references: [id])

  // Linear issue data (null linearIssueId means issue will be created on approval)
  linearIssueId         String?          @unique
  linearIssueIdentifier String?
  linearIssueTitle      String
  linearIssueUrl        String?
  linearTeamId          String

  // Request details
  requestedEstimate     Int
  projectedDueDate      DateTime
  description           String?
  note                  String?

  // Status
  status                PptRequestStatus @default(PENDING)
  rejectionReason       String?
  createdAt             DateTime         @default(now())
  reviewedAt            DateTime?

  @@index([requesterId])
  @@index([status])
}

// ── KYC Verification tables ─────────────────────────────────────────────────

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model KycVerification {
  id                  String     @id @default(cuid())
  userId              String
  user                UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  status              KycStatus  @default(PENDING)
  legalName           String
  documentType        String?    // mykad | passport | driving_licence
  idDocumentBlobUrl   String?
  selfieBlobUrl       String?
  rejectionReason     String?
  reviewerId          String?
  submittedAt         DateTime   @default(now())
  reviewedAt          DateTime?
  documentsDeletedAt  DateTime?
  expiresAt           DateTime

  auditLogs           KycAuditLog[]

  @@index([userId])
  @@index([status])
}

model KycAuditLog {
  id               String          @id @default(cuid())
  verificationId   String
  verification     KycVerification @relation(fields: [verificationId], references: [id])
  actorId          String
  action           String          // SUBMITTED | APPROVED | REJECTED | EXPIRED | DOCUMENTS_DELETED
  details          String?
  createdAt        DateTime        @default(now())

  @@index([verificationId])
}

// ── Welcome Pack tables ─────────────────────────────────────────────────────

enum WelcomePackOrderStatus {
  PENDING
  APPROVED
  SHIPPED
  DELIVERED
  CANCELLED
  REJECTED
}

enum ShippingRegion {
  DOMESTIC
  INTERNATIONAL
}

model WelcomePack {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  currentWave Int      @default(1)
  wave2Open   Boolean  @default(false)

  // ID card overlay configuration
  idCardTemplateBlobUrl String?
  idCardWidth           Int?
  idCardHeight          Int?
  idCardNameX           Int?
  idCardNameY           Int?
  idCardFontSize        Int?
  idCardFontColor       String?
  idCardFontFamily      String?
  // Text-box constraints + behaviour for long names.
  // Width/height in template px (null = unbounded).
  // Align: "left" | "center" | "right" (default "left").
  // WrapMode: "nowrap" (single line, may overflow) | "truncate" (single line + ellipsis)
  //         | "wrap" (multi-line within box) | "shrink" (single line, font auto-shrinks).
  idCardNameMaxWidth    Int?
  idCardNameMaxHeight   Int?
  idCardNameAlign       String?
  idCardNameWrapMode    String?

  items     WelcomePackItem[]
  orders    WelcomePackOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WelcomePackItem {
  id               String      @id @default(cuid())
  packId           String
  pack             WelcomePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  name             String
  description      String?
  imageBlobUrl     String?

  requiresSize     Boolean     @default(false)
  sizeChartBlobUrl String?
  sizeOptions      String[]

  displayOrder     Int         @default(0)
  isActive         Boolean     @default(true)

  selections       WelcomePackOrderItemSelection[]

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([packId])
}

model WelcomePackOrder {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  user            UserProfile            @relation(fields: [userId], references: [id])
  packId          String
  pack            WelcomePack            @relation(fields: [packId], references: [id])

  status          WelcomePackOrderStatus @default(PENDING)
  wave            Int

  idCardName      String

  region          ShippingRegion
  recipientName   String
  phone           String
  addressLine1    String
  addressLine2    String?
  city            String
  stateProvince   String?
  postalCode      String
  country         String

  trackingNumber  String?
  trackingUrl     String?
  notes           String?
  rejectionReason String?

  selections      WelcomePackOrderItemSelection[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  approvedAt      DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  @@index([status])
  @@index([packId])
}

model WelcomePackOrderItemSelection {
  id           String           @id @default(cuid())
  orderId      String
  order        WelcomePackOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       String
  item         WelcomePackItem  @relation(fields: [itemId], references: [id])
  selectedSize String?

  @@unique([orderId, itemId])
}
