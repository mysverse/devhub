# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.claude/*
# project skills are shared (dev-mode runbook for agents)
!.claude/skills

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-verify/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# committed fake values for dev mode (`pnpm dev:mock`)
!.env.mock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# visual verification output (pnpm visual)
/screenshots
