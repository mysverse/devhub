/// An admin pointing one developer at one task, with the reason. DevHub was
/// entirely pull-based: every earning path started with a developer going to
/// a board and choosing, and nothing was ever addressed to a person. This is
/// the push side, and the record of whether pushing worked.
model TaskSuggestion {
  id                    String                @id @default(cuid())
  linearIssueId         String
  linearIssueIdentifier String?
  linearIssueTitle      String
  userId                String
  user                  UserProfile           @relation("TaskSuggestionUser", fields: [userId], references: [id], onDelete: Cascade)
  suggestedById         String
  suggestedBy           UserProfile           @relation("TaskSuggestionActor", fields: [suggestedById], references: [id], onDelete: Cascade)
  /// The `because` line shown to the developer — from the ranker or an admin.
  reason                String
  note                  String?
  outcome               TaskSuggestionOutcome @default(PENDING)
  respondedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  /// Deliberately NOT unique on (linearIssueId, userId): a suggestion that
  /// went TAKEN or EXPIRED should be re-sendable if the task comes back to the
  /// board. The anti-nag rule is "one OPEN suggestion at a time", enforced in
  /// suggestTaskToDeveloper against outcome PENDING.
  @@index([linearIssueId, userId])
  @@index([userId, outcome])
  @@index([outcome, createdAt])
}

enum TaskSuggestionOutcome {
  PENDING
  /// They claimed the task that was suggested to them.
  CLAIMED
  /// Someone else claimed it, so the suggestion is moot.
  TAKEN
  /// Still unclaimed well after the nudge.
  EXPIRED
}

model PptAssignmentWatch {
  id                    String  @id @default(cuid())
  linearIssueId         String
  linearIssueIdentifier String?
  linearIssueTitle      String?
  linearIssueUrl        String?

  assigneeLinearId String
  assigneeEmail    String?
  assigneeName     String?
  userId           String?
  user             UserProfile? @relation("PptAssignmentWatchUser", fields: [userId], references: [id], onDelete: SetNull)

  assignedAt     DateTime
  lastActivityAt DateTime
  warnedAt       DateTime?
  snoozedUntil   DateTime?
  snoozeReason   String?
  unassignedAt   DateTime?
  status         PptAssignmentWatchStatus @default(ACTIVE)
  warningCount   Int                      @default(0)

  // Self-service "I'm blocked" state: pauses the stale clock, time-boxed via
  // selfBlockExpiresAt, auto-expires back to ACTIVE. selfBlockCount is
  // per-assignment (reset on new assignment) and drives the soft guardrail of
  // admin visibility at 2+.
  selfBlockedAt      DateTime?
  selfBlockReason    PptSelfBlockReason?
  selfBlockNote      String?
  selfBlockExpiresAt DateTime?
  selfBlockCount     Int                 @default(0)

  releasedBySelfAt       DateTime?
  // Prevents repeat idle nudges within one activity window.
  idleNudgedAt           DateTime?
  // Takeover provenance ("Reassign to me"): who previously held the task and
  // the required reason the taker gave.
  reassignedFromLinearId String?
  reassignReason         String?

  lastLinearCommentAt   DateTime?
  lastLinearCommentType String?
  lastAdminActionAt     DateTime?
  lastAdminActionById   String?
  lastAdminActionNote   String?
  metadata              Json?

  events PptAssignmentWatchEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([linearIssueId, assigneeLinearId])
  @@index([linearIssueId])
  @@index([userId, status])
  @@index([status, lastActivityAt])
  @@index([status, snoozedUntil])
  @@index([status, selfBlockExpiresAt])
}

// Audit trail for assignment-watch mechanics: claims, releases, takeovers,
// nudges, blocks, and admin actions. Powers the developer-visible history and
// the admin per-developer rollups.
model PptAssignmentWatchEvent {
  id            String             @id @default(cuid())
