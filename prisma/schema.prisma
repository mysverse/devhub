  linearIssueId         String?
  // Equals linearIssueId while the request is active (PENDING/APPROVED), NULL
  // once REJECTED. Postgres allows many NULLs in a unique index, so an issue can
  // accumulate many rejected requests but have at most one active request — which
  // lets a developer re-request after a rejection. Every status transition MUST
  // keep this in sync.
  activeLinearIssueId   String? @unique
  linearIssueIdentifier String?
  linearIssueTitle      String
  linearIssueUrl        String?
  linearTeamId          String
  linearProjectId       String?
